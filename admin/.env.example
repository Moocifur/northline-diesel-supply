# Copy to admin/.env (git-ignored).

# Where the admin sends API calls. Keep it as /api: the dev server (vite.config.js) and Netlify
# (netlify.toml) both proxy /api to the real API, which keeps the login cookie first-party.
VITE_API_URL=/api

# Development only: where the dev server forwards /api to. Must match PORT in api/.env.
API_PROXY_TARGET=http://localhost:4000
