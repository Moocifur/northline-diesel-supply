# Copy this file to api/.env and fill it in. The real .env is git-ignored.

# Postgres connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/demo_shop"

# Signs the login tokens. Use a long random string (e.g. `openssl rand -hex 32`).
JWT_SECRET="change-me-to-a-long-random-string"

# Port the API listens on. Not 3000, because the Next.js storefront uses that in development.
PORT=4000

# Only needed if a browser calls the API directly from a different origin.
# Comma-separated list. Leave empty when using the admin proxy (see admin/vite.config.js).
CORS_ORIGIN=

# Secret for the stock feed at GET /parts/supplier-feed.csv?token=...
# If this is empty the feed is disabled.
SUPPLIER_FEED_TOKEN="change-me"
